{
  "name": "@zooai/brand",
  "version": "0.1.0",
  "description": "Zoo brand card / hero / OG-image generator",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "zoo-brand": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hero": {
      "import": "./dist/hero.mjs",
      "require": "./dist/hero.js",
      "types": "./dist/hero.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/hero.ts src/cli.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/hero.ts src/cli.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "zoo",
    "zooai",
    "brand",
    "og-image",
    "social-card",
    "hero",
    "svg",
    "design-system"
  ],
  "author": "Zoo Labs Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zooai/brand.git"
  },
  "homepage": "https://github.com/zooai/brand",
  "dependencies": {
    "@zooai/logo": "1.0.5"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0"
}
